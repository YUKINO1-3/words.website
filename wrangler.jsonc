{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocabflow",
  "main": "apps/worker/index.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vocabflow",
      // Replace with the ID returned by `npx wrangler d1 create vocabflow`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "database/d1-migrations",
    },
  ],
}
