# Merge these into the server .env; do not overwrite existing paths or secrets.
PORT=3000
DATA_DIR=data
BACKUP_DIR=backups
LISTEN_HOST=127.0.0.1
# Set the exact external HTTPS origin when using a reverse proxy.
PUBLIC_ORIGIN=https://words.example.com
# Only when a local reverse proxy sets X-Forwarded-For and direct access is blocked.
TRUST_PROXY=
# Existing temporary IP deployment: PUBLIC_HOST=your-server-ip
PUBLIC_HOST=
# Secure by default. Set false explicitly ONLY for local/temporary HTTP testing.
AUTH_COOKIE_SECURE=true
# AI keys, URLs and model names are now configured separately for each account in the UI.
# Server-wide AI_API_KEY/AI_BASE_URL/AI_MODEL are not used for user requests.
